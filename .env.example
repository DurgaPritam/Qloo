# Qloo Taste AI
QLOO_API_KEY=
QLOO_BASE_URL=

# Planning model. LLM_PROVIDER is gemini (default) or anthropic; only the selected provider's key is needed.
LLM_PROVIDER=
GEMINI_API_KEY=
# Defaults to gemini-3.6-flash (decisions D35, D39).
GEMINI_MODEL=
# Comma-separated, tried in order when the main model is overloaded or out of quota
# (default gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite).
GEMINI_FALLBACK_MODELS=
# writer (default): code runs the steps, the model writes the brief and emails in one call.
# agent: the model chooses every tool (about six calls a run).
TAKEOVER_PLANNER=
ANTHROPIC_API_KEY=
# Input + output tokens a day across all live runs and LLM-only answers (default 2000000).
LLM_DAILY_TOKEN_BUDGET=

# Upstash Redis (caching / rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Takeover
# 1 = sample data instead of Qloo (local and preview only; the build fails in Vercel production).
TAKEOVER_MOCK=
# Live runs per day across all visitors (default 120). Size it to the Qloo plan.
TAKEOVER_DAILY_RUNS=
# Long random string; requests with header x-takeover-e2e set to it skip per-visitor limits (Playwright).
TAKEOVER_E2E_TOKEN=

# ---- Team product (docs/architecture.md). Database, Auth.js and Resend are built; the rest are proposals. ----
# Neon Postgres: pooled for the app, direct for `npm run db:migrate`. Without DATABASE_URL, local runs
# use PGlite in .data/pglite (TAKEOVER_DB=memory for a throwaway one). Required on Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TAKEOVER_DB=
# Auth.js magic links. AUTH_URL only outside Vercel.
AUTH_SECRET=
AUTH_URL=
# Google sign-in (an OAuth client from Google Cloud). Set both to show "Continue with Google".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend: sign-in links, invites, opt-in alerts, and outreach the user clicked Send on.
# Without it, local runs show emails at /dev/outbox (never on Vercel).
RESEND_API_KEY=
EMAIL_FROM=
# Public base URL for email links, QStash callbacks and Stripe return URLs.
APP_URL=
# Upstash QStash background jobs.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Vercel Blob (set automatically when a store is linked).
BLOB_READ_WRITE_TOKEN=
# Set to 1 only once the commercial agreement with Qloo is in place: until then production sells no
# paid plan and serves no public API (the hackathon Qloo key and quota can't serve paying customers).
QLOO_COMMERCIAL_TERMS=
# Stripe, test mode only (an sk_live_ key is refused). Server-side; prices are referenced by id.
# The webhook endpoint is /api/billing/webhook. Team prices are per seat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
# Where the Enterprise "Contact us" form emails (required in production; the dev outbox locally).
CONTACT_EMAIL=
# Qloo budgets enforced in lib/qloo/client.ts: global calls per UTC day, calls of that cap kept
# back from jobs, and an operator ceiling on every workspace's monthly allowance (the tier sets it).
QLOO_DAILY_CALL_CAP=
QLOO_JOB_RESERVE=
QLOO_WORKSPACE_MONTHLY_CALLS=
