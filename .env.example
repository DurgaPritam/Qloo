# Qloo Taste AI
QLOO_API_KEY=
QLOO_BASE_URL=

# Planning model. LLM_PROVIDER is gemini (default) or anthropic; only the selected provider's key is needed.
LLM_PROVIDER=
GEMINI_API_KEY=
# Defaults to gemini-3.6-flash (decisions D35, D39).
GEMINI_MODEL=
# Comma-separated, tried in order when the main model is overloaded or out of quota
# (default gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite).
GEMINI_FALLBACK_MODELS=
# writer (default): code runs the steps, the model writes the brief and emails in one call.
# agent: the model chooses every tool (about six calls a run).
TAKEOVER_PLANNER=
ANTHROPIC_API_KEY=
# Input + output tokens a day across all live runs and LLM-only answers (default 2000000).
LLM_DAILY_TOKEN_BUDGET=

# Upstash Redis (caching / rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Takeover
# 1 = sample data instead of Qloo (local and preview only; the build fails in Vercel production).
TAKEOVER_MOCK=
# Live runs per day across all visitors (default 120). Size it to the Qloo plan.
TAKEOVER_DAILY_RUNS=
# Long random string; requests with header x-takeover-e2e set to it skip per-visitor limits (Playwright).
TAKEOVER_E2E_TOKEN=

# ---- Team product (docs/architecture.md). Proposed; nothing below is used until it is approved and built. ----
# Neon Postgres: pooled for the app, direct for drizzle-kit migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Auth.js magic links. AUTH_URL only outside Vercel.
AUTH_SECRET=
AUTH_URL=
# Resend: sign-in links, invites, opt-in alerts, and outreach the user clicked Send on.
RESEND_API_KEY=
EMAIL_FROM=
# Public base URL for email links, QStash callbacks and Stripe return URLs.
APP_URL=
# Upstash QStash background jobs.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Vercel Blob (set automatically when a store is linked).
BLOB_READ_WRITE_TOKEN=
# Stripe (server-side only; prices are referenced by id).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Qloo budgets enforced in lib/qloo/client.ts: global calls per UTC day, calls of that cap kept
# back from jobs, and the default monthly allowance per workspace.
QLOO_DAILY_CALL_CAP=
QLOO_JOB_RESERVE=
QLOO_WORKSPACE_MONTHLY_CALLS=
