# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design hand-off archives (the unpacked folder is committed)
/design/*.zip

# playwright
/test-results/
/playwright-report/

# Personal planning notes: keep local, never commit
/docs/Takeover build playbook for Claude Code and Claude Design.md
/docs/playbook.md

# Raw Qloo probe output stays local (docs/decisions.md D6); the trimmed set is committed.
/tests/fixtures/*
!/tests/fixtures/qloo/

# local PGlite database (lib/db)
/.data/
